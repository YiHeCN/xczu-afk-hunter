{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.matrix-data/**",
    "**/.pnpm-store/**",
    "**/pnpm-lock.yaml",
    "**/*.md"
  ]
}
